{
  "name": "veda-ai-backend",
  "version": "1.0.0",
  "description": "VedaAI Assessment Creator - Backend",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "express": "^4.22.2",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.0",
    "dotenv": "^17.2.3",
    "@veda-ai/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
