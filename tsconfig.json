{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@veda-ai/shared": ["packages/shared/src"],
      "@veda-ai/shared/*": ["packages/shared/src/*"],
      "@veda-ai/frontend": ["packages/frontend/src"],
      "@veda-ai/frontend/*": ["packages/frontend/src/*"],
      "@veda-ai/backend": ["packages/backend/src"],
      "@veda-ai/backend/*": ["packages/backend/src/*"]
    }
  },
  "include": ["packages/*/src"],
  "exclude": ["node_modules", "**/*.dist"]
}
